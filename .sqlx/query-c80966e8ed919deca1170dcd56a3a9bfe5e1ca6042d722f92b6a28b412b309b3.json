  "query": "select s.id, s.name as \"title!\", co.name as \"subtitle?\",\n                      u.name as \"author?\", s.modified as \"at!\"\n               from store s\n               join company co on co.id = s.company\n               left join \"user\" u on u.id = s.modified_by\n               where s.deleted order by s.modified desc",
