  "query": "select s.id, s.name as \"title!\", s.address as \"subtitle?\",\n                          u.name as \"author?\", s.created as \"at!\"\n                   from store s left join \"user\" u on u.id = s.created_by\n                   where not s.approved and not s.deleted order by s.created",
