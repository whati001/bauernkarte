  "query": "select s.id, s.name as \"title!\", null as \"subtitle?\",\n                      u.name as \"author?\", s.modified as \"at!\"\n               from store s\n               left join \"user\" u on u.id = s.modified_by\n               where s.deleted order by s.modified desc",
