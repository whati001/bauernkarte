  "db_name": "PostgreSQL",
  "query": "select p.id, p.name, p.description, p.icon,\n                  count(sp.id) as \"stores!\"\n           from product p\n           left join store_product sp on sp.product = p.id and sp.approved and not sp.deleted\n           where p.approved and not p.deleted\n           group by p.id\n           order by p.name",
