  "query": "select i.id, i.store as store_id, s.name as store_name, i.description,\n                  i.kind = 'owner' as \"is_owner!\", i.cover\n           from image i join store s on s.id = i.store\n           where i.approved and not i.deleted\n           order by i.id desc",
