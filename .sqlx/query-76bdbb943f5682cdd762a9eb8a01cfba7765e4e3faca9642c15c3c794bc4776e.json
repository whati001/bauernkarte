  "query": "select i.id, s.name as \"title!\", i.description as \"subtitle?\",\n                      u.name as \"author?\", i.modified as \"at!\"\n               from image i\n               join store s on s.id = i.store\n               left join \"user\" u on u.id = i.modified_by\n               where i.deleted order by i.modified desc",
