# Template for `.env`. `./bootstrap.py env` generates the same keys with
# these dev defaults and a derived DATABASE_URL — this file is for doing
# it by hand. Read by docker-compose.yml (variable interpolation),
# bootstrap.py and the app itself; see bootstrap.md.

# Credentials. docker-compose.yml passes these to the `db` service and
# builds the `app` service's DATABASE_URL (`db:5432`) from them.
DB_USER=bauernkarte
DB_PWD=dev
DB_NAME=bauernkarte
# The host's view of the db: DB_PORT is the port compose publishes.
DB_HOST=127.0.0.1
DB_PORT=5434

# Derived from the DB_* values above — keep the two in sync.
DATABASE_URL=postgres://bauernkarte:dev@127.0.0.1:5434/bauernkarte

# Host port the `app` container publishes; BIND_ADDR is for `cargo run`.
APP_PORT=3000
BIND_ADDR=0.0.0.0:3000
# Password for the seeded admin account (bauernkarte@rehka.dev), applied
# once on the first startup that finds it without one. Changing it later
# through the app sticks; this value is not re-applied.
ADMIN_PASSWORD=bitte-hier-aendern-2026

# Set `true` only behind a TLS-terminating proxy — a `Secure` session
# cookie over plain HTTP makes login silently fail.
SECURE_COOKIES=false
RUST_LOG=bauernkarte=debug,tower_http=debug
