# syntax=docker/dockerfile:1

# The `db` service image: official Postgres, with PostGIS compiled on
# top.
#
# Why not `postgis/postgis` directly? The official `postgres` image is
# the one with a manifest covering both amd64 and arm64, so this file
# produces the same database on an x86 server and an ARM laptop.
# PostGIS has to be built here because Alpine's `postgis` package links
# against Alpine's own `postgresql` package, not the from-source server
# this base image ships.
FROM docker.io/library/postgres:18.6-alpine3.24

# The tarball is fetched over the network at build time; the pinned
# version plus checksum is what keeps that reproducible.
ENV POSTGIS_VERSION=3.6.4
ENV POSTGIS_SHA256=ed8dc6679f1e06f7b113592b04cde2a7e00f1b1e681294c8ca2204058990cec6

RUN set -eux \
    && apk add --no-cache --virtual .build-deps \
        # Set by the base image: the llvm/clang versions matching its
        # Postgres build. PGXS emits JIT bitcode for the extension, so
        # they're needed even though nothing here is written in C++.
        $DOCKER_PG_LLVM_DEPS \
        file \
        g++ \
        gcc \
        geos-dev \
        json-c-dev \
        libxml2-dev \
        make \
        perl \
        proj-dev \
    \
    && wget -O postgis.tar.gz "https://download.osgeo.org/postgis/source/postgis-${POSTGIS_VERSION}.tar.gz" \
    && echo "${POSTGIS_SHA256}  postgis.tar.gz" | sha256sum -c - \
    && mkdir -p /usr/src/postgis \
    && tar --extract --file postgis.tar.gz --directory /usr/src/postgis --strip-components 1 \
    && rm postgis.tar.gz \
    \
    # Only the plain `postgis` extension is used (`store.position` is a
    # geography, see migration 20260812161501). The rest of the stack —
    # raster, topology, tiger geocoder, MVT — would pull in gdal,
    # protobuf-c and pcre2 for nothing.
    && cd /usr/src/postgis \
    && ./configure \
        --without-raster \
        --without-topology \
        --without-tiger \
        --without-address-standardizer \
        --without-protobuf \
    # `-j` only for the C compilation, and a serial pass for the rest.
    # `utils/` builds `postgis_restore.pl` out of the drop signatures of
    # *every* component, so it recurses into `raster/` and `topology/`
    # even though both are configured out — and twice into each, from two
    # separate rules. Under `-j` those two sub-makes run concurrently in
    # the same directory and race over a shared `rtpostgis.sql.tmp`: one
    # deletes it while the other is still reading it, which truncates
    # `rtpostgis.sql` and kills the build in `create_upgrade.pl`.
    && make -j"$(nproc)" -C liblwgeom \
    && make -j"$(nproc)" -C libpgcommon \
    && make -j"$(nproc)" -C postgis \
    && make \
    && make install \
    \
    # Keep the shared libraries the extension links against, drop the
    # headers and the toolchain.
    && apk add --no-cache --virtual .postgis-rundeps \
        geos \
        json-c \
        libstdc++ \
        libxml2 \
        proj \
    && cd / \
    && rm -rf /usr/src/postgis \
    && apk del --no-network .build-deps
